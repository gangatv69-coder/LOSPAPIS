{
  "name": "@los-papis/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./types": {
      "types": "./src/types.ts"
    }
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env src/index.ts",
    "build": "tsdown",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@hono/zod-validator": "catalog:",
    "@los-papis/db": "workspace:*",
    "@los-papis/shared": "workspace:*",
    "hono": "catalog:",
    "pino": "catalog:",
    "web-push": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/web-push": "catalog:",
    "pino-pretty": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
