# Copia este archivo a apps/api/.env (no se versiona). `pnpm dev` lo carga con --env-file-if-exists=.env
NODE_ENV=development
PORT=3000
# En Windows, escuchar solo en localhost evita el aviso del firewall. En Docker se deja sin definir.
HOST=127.0.0.1
APP_VERSION=0.1.0-dev
LOG_LEVEL=debug

# --- Base de datos (rol app, LP-05). La base la arranca `pnpm db:up` y publica 127.0.0.1:5432. ---
# O las piezas (DB_HOST por defecto 127.0.0.1; compose lo fija a db), o DATABASE_URL completa, que manda:
#   DATABASE_URL=postgres://app:app-dev@127.0.0.1:5432/los_papis
DB_HOST=127.0.0.1
DB_PORT=5432
DB_APP_USER=app
DB_APP_PASSWORD=app-dev
POSTGRES_DB=los_papis

# --- Acceso (LP-05). Valores SOLO de desarrollo (los mismos que .env.example de la raíz). ---
# Barbería de este despliegue (slug de la tabla shops; la crea pnpm db:seed).
APP_SHOP_SLUG=los-papis
# Firma las aserciones de PIN y los códigos de respaldo: 32 caracteres como mínimo (openssl rand -base64 48).
AUTH_SECRET=dev-only-auth-secret-los-papis-0123456789abcdef0123456789abcdef
# Cifra los secretos TOTP en la base: 32 bytes en base64 (openssl rand -base64 32).
AUTH_ENCRYPTION_KEY=ZGV2LW9ubHkta2V5LWxvcy1wYXBpcy0wMTIzNDU2Nzg=
# Cookies `secure` con prefijo __Host-: sin definir se deduce de PUBLIC_URL (https → true). En el PC, http → sin.
COOKIE_SECURE=

# --- Avisos push (LP-03, prueba S4). Vacías = la API arranca con los avisos desactivados. ---
# Genera un par de claves tras `pnpm --filter @los-papis/api run build` y pégalo aquí (en .env):
#   node dist/vapid-keys.mjs            (o, desde la raíz: cmd /c "node apps\api\dist\vapid-keys.mjs >> apps\api\.env")
# Las dos claves van juntas; con una sola la API no arranca.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Identidad que firma los avisos: https://... o mailto:... (Apple rechaza http: y localhost). Si está vacía se
# usa PUBLIC_URL, que en desarrollo es http://, así que para probar en el PC pon aquí, por ejemplo,
# https://pruebas.37-27-38-218.sslip.io (o un mailto:).
VAPID_SUBJECT=
# URL con la que se abre la app (origen que acepta la guardia CSRF). En el servidor la fija compose.
PUBLIC_URL=http://localhost:5173
