# Copia este archivo a apps/api/.env (no se versiona). `pnpm dev` lo carga con --env-file-if-exists=.env
NODE_ENV=development
PORT=3000
# En Windows, escuchar solo en localhost evita el aviso del firewall. En Docker se deja sin definir.
HOST=127.0.0.1
APP_VERSION=0.1.0-dev
LOG_LEVEL=debug

# --- Avisos push (LP-03, prueba S4). Vacías = la API arranca con los avisos desactivados. ---
# Genera un par de claves tras `pnpm --filter @los-papis/api run build` y pégalo aquí (en .env):
#   node dist/vapid-keys.mjs            (o, desde la raíz: cmd /c "node apps\api\dist\vapid-keys.mjs >> apps\api\.env")
# Las dos claves van juntas; con una sola la API no arranca.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Identidad que firma los avisos: https://... o mailto:... (Apple rechaza http: y localhost). Si está vacía se
# usa PUBLIC_URL, que en desarrollo es http://, así que para probar en el PC pon aquí, por ejemplo,
# https://pruebas.37-27-38-218.sslip.io (o un mailto:).
VAPID_SUBJECT=
# URL con la que se abre la app. En el servidor de pruebas la fija compose (https://pruebas.37-27-38-218.sslip.io).
PUBLIC_URL=http://localhost:5173
