{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // DOM: los callbacks de page.evaluate (e2e y scripts/make-icons.ts) corren en el navegador.
    "lib": ["ES2024", "DOM"],
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "e2e",
    "test",
    "scripts"
  ]
}
