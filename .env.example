# Variables de la base de datos de LOS PAPIS. Sin .env, TODO (docker compose, pnpm db:*, las pruebas) usa
# estos valores de desarrollo. Para cambiarlos: copia este archivo a .env en la raíz (no se versiona) y
# edita .env. En el VPS (LP-03) se cambian todos. El de la API sigue en apps/api/.env.example.

# --- Servicio db de compose.yaml (imagen postgres:18) ---
# Superusuario de la imagen: solo lo usan la propia imagen y infra/postgres/init/01-roles.sh.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres-dev
POSTGRES_DB=los_papis
# Roles de la aplicación (los crea 01-roles.sh la primera vez que arranca el volumen de datos).
DB_OWNER_PASSWORD=owner-dev
DB_APP_PASSWORD=app-dev
# Base de datos de pruebas (la crea 01-roles.sh; pnpm test la vacía y la migra en cada ejecución).
POSTGRES_TEST_DB=los_papis_test

# --- Lo que usan pnpm db:migrate, pnpm db:seed y las pruebas desde el PC ---
# owner aplica migraciones; app es lo que usa la API. 127.0.0.1:5432 es el puerto que publica compose.
# El servicio api de compose.yaml vacía DATABASE_URL y construye la suya con DB_HOST=db y DB_APP_PASSWORD.
DATABASE_URL_OWNER=postgres://owner:owner-dev@127.0.0.1:5432/los_papis
DATABASE_URL=postgres://app:app-dev@127.0.0.1:5432/los_papis

# --- Catálogo (LP-08): lo lee el servicio migrate de compose.yaml ---
# example = carga los ejemplos de la maqueta (servicios, productos y los usuarios barbero1/barbero2 sin
# contraseña) que falten; nunca toca lo que ya existe. En producción: none. (pnpm db:seed los carga siempre.)
SEED_CATALOG=example

# --- Acceso (LP-05): los lee el servicio api de compose.yaml; pnpm dev los toma de apps/api/.env ---
# Firma las aserciones de PIN y los códigos de respaldo (HMAC): 32 caracteres como mínimo. Este valor es SOLO
# de desarrollo; en el servidor lo genera infra/server/deploy-remote.sh con `openssl rand -base64 48`.
AUTH_SECRET=dev-only-auth-secret-los-papis-0123456789abcdef0123456789abcdef
# Cifra los secretos TOTP de los managers en la base (AES-256-GCM): 32 bytes en base64. Solo desarrollo; en el
# servidor la genera deploy-remote.sh con `openssl rand -base64 32`. Si cambia, los secretos TOTP ya guardados
# dejan de poder leerse (cada manager tendría que configurar la 2FA de nuevo).
AUTH_ENCRYPTION_KEY=ZGV2LW9ubHkta2V5LWxvcy1wYXBpcy0wMTIzNDU2Nzg=
# Barbería de este despliegue: slug de la tabla shops (la crean pnpm db:seed y el servicio migrate de compose).
APP_SHOP_SLUG=los-papis

# --- Avisos push (LP-03, prueba S4): los lee el servicio api de compose.yaml ---
# Vacías = la API arranca con los avisos desactivados (/api/push/config responde enabled: false).
# Para probarlos en el PC genera un par de claves y añádelo a .env (nunca a este archivo). Con cmd /c porque el
# ">>" de PowerShell 5.1 escribiría el archivo en UTF-16:
#   pnpm --filter @los-papis/api run build; cmd /c "node apps\api\dist\vapid-keys.mjs >> .env"
#   (o con la imagen ya construida: cmd /c "docker run --rm los-papis-api:local node vapid-keys.mjs >> .env")
# En el servidor las genera infra/server/deploy-remote.sh en /opt/los-papis/.env.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Identidad que firma los avisos: https://... o mailto:... (Apple rechaza http: y localhost). Si está vacía se usa
# PUBLIC_URL, que en el PC es http://, así que para probar en local escribe en .env, por ejemplo,
# VAPID_SUBJECT=https://pruebas.37-27-38-218.sslip.io (o un mailto:).
VAPID_SUBJECT=
# URL con la que se abre la app; compose se la pasa a la API. En el servidor: https://pruebas.37-27-38-218.sslip.io.
# Con https las cookies de sesión llevan `secure` y el prefijo __Host- (COOKIE_SECURE=true/false lo fuerza).
PUBLIC_URL=http://localhost:8080
